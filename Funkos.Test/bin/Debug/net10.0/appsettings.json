{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Application": {
    "Name": "FunkosApi",
    "Version": "1.0.0"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=FunkosDb;Username=admin;Password=admin123"
  },
    "MongoDbSettings": {
      "ConnectionString": "mongodb://admin:admin123@localhost:27017/ProvDb?authSource=admin",
      "DatabaseName": "ProvDb"
  },
  "Cache": {
    "DefaultExpirationMinutes": 30,
    "SlidingExpirationMinutes": 10
  },
  "Redis": {
    "ConnectionString": "localhost:6379,password=miPassword123"
  },
  "Storage": {
    "UploadPath": "wwwroot/uploads",
    "MaxFileSize": 5242880,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".gif", ".webp"],
    "AllowedContentTypes": ["image/jpeg", "image/png", "image/gif", "image/webp"]
  },
  "Jwt": {
    "Secret": "BICHARRACO_DE_CLAVE_SECRETA_MARCOS_EL_MEJOR_DEL_MUNDO1",
    "Issuer": "FunkosApi",
    "Audience": "FunkosClient"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/funkos-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  }
}